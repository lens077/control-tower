          "type": "string"
        },
        "enable": {
          "default": false,
          "type": "boolean"
        },
        "insecure_skip_verify": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Tls",
      "type": "object"
    },
    "conf.v1.Observability.Trace.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(sampleRatio)$": {
          "$ref": "#/$defs/google.protobuf.DoubleValue.schema.json",
          "description": "采样率 [0.0, 1.0]。1.0 = 全采,0.0 = 全不采。\n 用 wrapper 而不是裸 double:proto3 裸 double 的零值就是 0.0,和「没配置」\n 无法区分 —— 那样所有存量配置(都还没有这个字段)升级后会被解析成 0.0,\n 等于一条 trace 都不采,而且不报任何错。wrapper 让「没配」是 null,\n 由代码回落到 1.0,与升级前的 AlwaysSample 行为一致。"
        }
      },
      "properties": {
        "endpoint": {
          "default": "",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\[(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)\\]):([1-9][0-9]{0,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "type": "string"
        },
        "sample_ratio": {
          "$ref": "#/$defs/google.protobuf.DoubleValue.schema.json",
          "description": "采样率 [0.0, 1.0]。1.0 = 全采,0.0 = 全不采。\n 用 wrapper 而不是裸 double:proto3 裸 double 的零值就是 0.0,和「没配置」\n 无法区分 —— 那样所有存量配置(都还没有这个字段)升级后会被解析成 0.0,\n 等于一条 trace 都不采,而且不报任何错。wrapper 让「没配」是 null,\n 由代码回落到 1.0,与升级前的 AlwaysSample 行为一致。"
        },
        "tls": {
          "$ref": "#/$defs/conf.v1.Observability.Tls.schema.json"
        }
      },
      "title": "Trace",
      "type": "object"
    },
    "conf.v1.Observability.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "default": false,
          "type": "boolean"
        },
        "log": {
          "$ref": "#/$defs/conf.v1.Observability.Logging.schema.json"
        },
        "metric": {
          "$ref": "#/$defs/conf.v1.Observability.Metric.schema.json"
        },
        "trace": {
          "$ref": "#/$defs/conf.v1.Observability.Trace.schema.json"
        }
      },
      "title": "Observability",
      "type": "object"
    },
    "conf.v1.Recommend.Gorse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(apiKey)$": {
          "default": "",
          "description": "对应 gorse config.toml 的 [server] api_key,空表示未开启鉴权",
          "type": "string"
        }
      },
      "properties": {
        "api_key": {
          "default": "",
          "description": "对应 gorse config.toml 的 [server] api_key,空表示未开启鉴权",
          "type": "string"
        },
        "enable": {
          "default": false,
          "description": "关掉之后完全不碰 gorse,用于 gorse 挂了时保住商品主链路",
          "type": "boolean"
        },
        "endpoint": {
          "default": "",
          "description": "gorse-in-one 的 RESTful 端口,形如 http://gorse:8088",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?://(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        },
        "timeout": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json"
        }
      },
      "title": "Gorse",
      "type": "object"
    },
    "conf.v1.Recommend.ItemSync.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "商品服务目前没有 SPU 的写入 RPC,没有地方能挂\"写完就同步\"的钩子;\n 就算以后有了,单靠写路径同步也会在 gorse 重装、网络抖动后留下永久缺口。\n 所以这里用轮询兜底,写路径将来直接调 SyncByCodes 做即时补充。",
      "patternProperties": {
        "^(batchSize)$": {
          "anyOf": [
            {
              "exclusiveMaximum": 4294967296,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "单轮最多扫多少行。批次内按 updated_at 推进游标,扫满了下一轮立即继续。"
        },
        "^(cursorLookback)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "游标回拨量。updated_at 相同的行可能跨批次,回拨一点重扫,\n upsert 本身幂等,重复同步的代价远小于漏掉商品。"
        }
      },
      "properties": {
        "batch_size": {
          "anyOf": [
            {
              "exclusiveMaximum": 4294967296,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "单轮最多扫多少行。批次内按 updated_at 推进游标,扫满了下一轮立即继续。"
        },
        "cursor_lookback": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "游标回拨量。updated_at 相同的行可能跨批次,回拨一点重扫,\n upsert 本身幂等,重复同步的代价远小于漏掉商品。"
        },
        "enable": {
          "default": false,
          "description": "关掉之后不启动后台同步,但 SyncByCodes 仍然可用",
          "type": "boolean"
        },
        "interval": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "两轮增量扫描的间隔"
        }
      },
      "title": "ItemSync 是按 updated_at 游标的增量对账。",
      "type": "object"
    },
    "conf.v1.Recommend.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "gorse 只认识 item,不认识我们的 SPU 表。用户行为(behavior 服务投喂的 feedback)\n 引用的 ItemId 必须先作为 item 存在,否则那条反馈会被 gorse 直接丢掉 ——\n 所以这份同步是推荐链路的前置条件,不是可选的锦上添花。",
      "patternProperties": {
        "^(itemSync)$": {
          "$ref": "#/$defs/conf.v1.Recommend.ItemSync.schema.json"
        }
      },
      "properties": {
        "gorse": {
          "$ref": "#/$defs/conf.v1.Recommend.Gorse.schema.json"
        },
        "item_sync": {
          "$ref": "#/$defs/conf.v1.Recommend.ItemSync.schema.json"
        }
      },
      "title": "Recommend 把商品目录同步给 gorse。",
      "type": "object"
    },
    "conf.v1.Server.Cors.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
