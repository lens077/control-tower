          "$ref": "#/$defs/google.protobuf.Duration.schema.json"
        },
        "read_timeout": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json"
        },
        "write_timeout": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json"
        }
      },
      "title": "HTTP",
      "type": "object"
