      ],
      "description": "The double value.",
      "title": "Double Value"
    },
    "google.protobuf.Duration.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "pattern": "^-?([0-9]+([.][0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "title": "Duration",
      "type": "string"
    }
  },
