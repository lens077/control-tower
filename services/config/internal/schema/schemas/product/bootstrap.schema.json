              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "read_timeout": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json"
