          "type": "string"
        },
        "min_idle_conns": {
          "anyOf": [
            {
              "exclusiveMaximum": 4294967296,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "password": {
