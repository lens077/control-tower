    "conf.v1.Observability.Metric.Guard.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(hardShutdown)$": {
          "default": false,
          "description": "true:熔断即关闭底层导出器,不再探测。用于确定要下线的端点。",
          "type": "boolean"
        },
        "^(initialBackoff)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "首次失败后的退避窗口,之后按 multiplier 递增并封顶 max_backoff。\n 不配置回落到 2s。"
        },
        "^(maxBackoff)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "退避窗口上限。不配置回落到 5m。"
        },
        "^(maxFailures)$": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "连续失败多少次熔断。30s 采集周期下 8 次约 4 分钟;按需下调可更快止噪。"
        },
        "^(probeInterval)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "熔断后每隔多久放行一次探测导出,探测成功即恢复。不配置回落到 5m。"
        }
      },
      "properties": {
        "disable": {
          "default": false,
          "description": "显式关闭保护:true 时导出失败恢复为每次采集都打一条错误日志(升级前的行为)。\n 字段故意叫 disable 而不是 enable:kit 默认已开启保护,裸 bool 的零值恰好是\n false,用 enable 会让「只写了 ntfy、没写 enable」的服务静默关掉保护。\n 也不能用 google.protobuf.BoolValue:配置解码走 mapstructure 且没有 wrapper\n 钩子,那样要求写成 enable: {value: true}(2026-10-07 实测解码报错)。",
          "type": "boolean"
        },
        "hard_shutdown": {
          "default": false,
          "description": "true:熔断即关闭底层导出器,不再探测。用于确定要下线的端点。",
          "type": "boolean"
        },
        "initial_backoff": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "首次失败后的退避窗口,之后按 multiplier 递增并封顶 max_backoff。\n 不配置回落到 2s。"
        },
        "jitter": {
          "anyOf": [
            {
              "exclusiveMaximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "退避抖动比例 [0, 1)。裸 double 无法区分「没配置」与「配了 0」,因此 0(含\n 不写)统一按未配置处理、回落到 kit 默认的 0.3;要更小的抖动就填大于 0 的数。\n 不能用 google.protobuf.DoubleValue:配置解码走 mapstructure 且没有 wrapper\n 钩子,那样要求写成 jitter: {value: 0.3},而 JSON Schema 又按裸数字放行——\n 两个门禁不一致,只在本地有 dev.yml 时才会被解码测试抓到。"
        },
        "max_backoff": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "退避窗口上限。不配置回落到 5m。"
        },
        "max_failures": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "连续失败多少次熔断。30s 采集周期下 8 次约 4 分钟;按需下调可更快止噪。"
        },
        "multiplier": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "number"
            },
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "退避递增倍数。不配置回落到 2.0。"
        },
        "ntfy": {
          "$ref": "#/$defs/conf.v1.Observability.Metric.Ntfy.schema.json"
        },
        "probe_interval": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "熔断后每隔多久放行一次探测导出,探测成功即恢复。不配置回落到 5m。"
        }
      },
      "title": "Guard",
      "type": "object"
    },
    "conf.v1.Observability.Metric.Ntfy.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(alertPriority)$": {
          "default": "",
          "description": "熔断通知的 ntfy Priority 头,不配置用 urgent。",
          "maxLength": 16,
          "type": "string"
        },
        "^(recoveryPriority)$": {
          "default": "",
          "description": "恢复通知的 ntfy Priority 头,不配置用 default。",
          "maxLength": 16,
          "type": "string"
        }
      },
      "properties": {
        "alert_priority": {
          "default": "",
          "description": "熔断通知的 ntfy Priority 头,不配置用 urgent。",
          "maxLength": 16,
          "type": "string"
        },
        "recovery_priority": {
          "default": "",
          "description": "恢复通知的 ntfy Priority 头,不配置用 default。",
          "maxLength": 16,
          "type": "string"
        },
        "token": {
          "default": "",
          "description": "可选 Bearer Token。凭据类信息,不写进仓库与日志。",
          "maxLength": 512,
          "type": "string"
        },
        "topic": {
          "default": "",
          "description": "订阅主题。凭据类信息,不写进仓库与日志。",
          "maxLength": 128,
          "type": "string"
        },
        "url": {
          "default": "",
          "description": "ntfy 服务地址,形如 https://ntfy.example.com,不带主题路径。",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?://(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        }
      },
      "title": "Ntfy",
      "type": "object"
    },
    "conf.v1.Observability.Metric.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(exportInterval)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "指标导出间隔。不配置回落到 30s。\n (OTel SDK 默认 60s;这里取 30s,原来硬编码的 3s 对 collector 压力过大)"
        }
      },
      "properties": {
        "endpoint": {
          "default": "",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\[(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)\\]):([1-9][0-9]{0,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "type": "string"
        },
        "export_interval": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "指标导出间隔。不配置回落到 30s。\n (OTel SDK 默认 60s;这里取 30s,原来硬编码的 3s 对 collector 压力过大)"
        },
        "guard": {
          "$ref": "#/$defs/conf.v1.Observability.Metric.Guard.schema.json",
          "description": "指标导出保护:失败按指数退避、连续失败熔断,熔断与恢复各发一次 ntfy 告警,\n 熔断期间不再向业务日志刷导出错误。不配置时由 go-connect-kit/otelguard 的\n 默认值兜底(MaxFailures=8、InitialBackoff=2s、MaxBackoff=5m、\n Multiplier=2.0、Jitter=0.3、ProbeInterval=5m)。\n ntfy 的 topic 与 token 属于凭据类信息,只写在 Config Center,不落仓库。"
        },
        "tls": {
          "$ref": "#/$defs/conf.v1.Observability.Tls.schema.json"
        }
      },
      "title": "Metric",
      "type": "object"
    },
    "conf.v1.Observability.Tls.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(caPem)$": {
          "default": "",
          "type": "string"
        },
        "^(insecureSkipVerify)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "ca_pem": {
          "default": "",
          "type": "string"
        },
        "enable": {
          "default": false,
          "type": "boolean"
        },
        "insecure_skip_verify": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Tls",
      "type": "object"
    },
    "conf.v1.Observability.Trace.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(sampleRatio)$": {
          "$ref": "#/$defs/google.protobuf.DoubleValue.schema.json",
          "description": "采样率 [0.0, 1.0]。1.0 = 全采,0.0 = 全不采。\n 用 wrapper 而不是裸 double:proto3 裸 double 的零值就是 0.0,和「没配置」\n 无法区分 —— 那样所有存量配置(都还没有这个字段)升级后会被解析成 0.0,\n 等于一条 trace 都不采,而且不报任何错。wrapper 让「没配」是 null,\n 由代码回落到 1.0,与升级前的 AlwaysSample 行为一致。"
        }
      },
      "properties": {
        "endpoint": {
          "default": "",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9-]{0,63}(\\.[A-Za-z0-9-][A-Za-z0-9-]{0,63})*|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|\\[(([0-9a-fA-F]{1,4}::?){1,7}([0-9a-fA-F]{1,4})|([0-9a-fA-F]{1,4}:){1,7}:|:((([0-9a-fA-F]{1,4}:){1,6})?[0-9a-fA-F]{1,4})?|::)\\]):([1-9][0-9]{0,4}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
          "type": "string"
        },
        "sample_ratio": {
          "$ref": "#/$defs/google.protobuf.DoubleValue.schema.json",
          "description": "采样率 [0.0, 1.0]。1.0 = 全采,0.0 = 全不采。\n 用 wrapper 而不是裸 double:proto3 裸 double 的零值就是 0.0,和「没配置」\n 无法区分 —— 那样所有存量配置(都还没有这个字段)升级后会被解析成 0.0,\n 等于一条 trace 都不采,而且不报任何错。wrapper 让「没配」是 null,\n 由代码回落到 1.0,与升级前的 AlwaysSample 行为一致。"
        },
        "tls": {
          "$ref": "#/$defs/conf.v1.Observability.Tls.schema.json"
        }
      },
      "title": "Trace",
      "type": "object"
    },
    "conf.v1.Observability.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "enable": {
          "default": false,
