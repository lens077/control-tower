    "conf.v1.Recommend.Gorse.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(apiKey)$": {
          "default": "",
          "description": "对应 gorse config.toml 的 [server] api_key,空表示未开启鉴权",
          "type": "string"
        }
      },
      "properties": {
        "api_key": {
          "default": "",
          "description": "对应 gorse config.toml 的 [server] api_key,空表示未开启鉴权",
          "type": "string"
        },
        "enable": {
          "default": false,
          "description": "关掉之后只落库不投喂,用于 gorse 挂了时保住主链路",
          "type": "boolean"
        },
        "endpoint": {
          "default": "",
          "description": "gorse-in-one 的 RESTful 端口,形如 http://gorse:8088",
          "pattern": "^(?:(?:[a-zA-Z][a-zA-Z\\d+\\-.]*):)?(?://(?:[A-Za-z0-9\\-\\.]+(?::\\d+)?))?(/[^\\?#]*)?(?:\\?([^\\#]*))?(?:\\#(.*))?$",
          "type": "string"
        },
        "timeout": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json"
        }
      },
      "title": "Gorse",
      "type": "object"
    },
    "conf.v1.Recommend.Ingest.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Ingest 控制\"逛\"产生的高频事件如何被削峰。",
      "patternProperties": {
        "^(batchSize)$": {
          "anyOf": [
            {
              "exclusiveMaximum": 4294967296,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "攒够多少条立即 flush"
        },
        "^(flushInterval)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "没攒够也要 flush 的兜底间隔"
        },
        "^(impressionDedupTtl)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "同一会话内同一商品的曝光去重窗口。列表页滚动会反复触发曝光,不去重会把\n read_feedback_types 刷爆。"
        },
        "^(maxClockSkew)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "客户端时间戳与服务端时钟的最大允许偏移,超过则用服务端接收时间纠正。\n 前端时钟不可信,不纠正会污染 gorse 的 positive_feedback_ttl 淘汰。"
        },
        "^(queueSize)$": {
          "anyOf": [
            {
              "exclusiveMaximum": 4294967296,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "内存队列容量。写满后新事件直接丢弃并计入 dropped,绝不阻塞 Track 请求。"
        },
        "^(retryBatchSize)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "单次补偿投递最多捞多少条"
        },
        "^(retryInterval)$": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "补偿投递:重扫 synced_at IS NULL 的事件重新投喂 gorse 的间隔,0 表示关闭"
        }
      },
      "properties": {
        "batch_size": {
          "anyOf": [
            {
              "exclusiveMaximum": 4294967296,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "攒够多少条立即 flush"
        },
        "flush_interval": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "没攒够也要 flush 的兜底间隔"
        },
        "impression_dedup_ttl": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "同一会话内同一商品的曝光去重窗口。列表页滚动会反复触发曝光,不去重会把\n read_feedback_types 刷爆。"
        },
        "max_clock_skew": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "客户端时间戳与服务端时钟的最大允许偏移,超过则用服务端接收时间纠正。\n 前端时钟不可信,不纠正会污染 gorse 的 positive_feedback_ttl 淘汰。"
        },
        "queue_size": {
          "anyOf": [
            {
              "exclusiveMaximum": 4294967296,
              "minimum": 1,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "内存队列容量。写满后新事件直接丢弃并计入 dropped,绝不阻塞 Track 请求。"
        },
        "retry_batch_size": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "单次补偿投递最多捞多少条"
        },
        "retry_interval": {
          "$ref": "#/$defs/google.protobuf.Duration.schema.json",
          "description": "补偿投递:重扫 synced_at IS NULL 的事件重新投喂 gorse 的间隔,0 表示关闭"
        }
      },
      "title": "Ingest",
      "type": "object"
    },
    "conf.v1.Recommend.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
